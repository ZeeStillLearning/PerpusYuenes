{
  "info": {
    "name": "Perpustakaan Kampus",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8080/api" },
    { "key": "anggota_key", "value": "anggota-dev-001" },
    { "key": "petugas_key", "value": "petugas-dev-001" }
  ],
  "item": [
    {
      "name": "Ping",
      "request": { "method": "GET", "url": "{{base_url}}/ping" }
    },
    {
      "name": "Katalog Buku",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "{{anggota_key}}" }],
        "url": "{{base_url}}/v1/perpus/buku"
      }
    },
    {
      "name": "Detail Buku",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "{{anggota_key}}" }],
        "url": "{{base_url}}/v1/perpus/buku/ISBN-001"
      }
    },
    {
      "name": "Pinjam Buku",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-API-Key", "value": "{{anggota_key}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"isbn\":\"ISBN-002\"}"
        },
        "url": "{{base_url}}/v1/perpus/peminjaman"
      }
    },
    {
      "name": "Riwayat Peminjaman",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "{{anggota_key}}" }],
        "url": "{{base_url}}/v1/perpus/peminjaman"
      }
    },
    {
      "name": "Detail Peminjaman",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "{{anggota_key}}" }],
        "url": "{{base_url}}/v1/perpus/peminjaman/PJM-20260916-0001"
      }
    },
    {
      "name": "Kembalikan Buku",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-API-Key", "value": "{{petugas_key}}" }],
        "url": "{{base_url}}/v1/perpus/peminjaman/PJM-20260916-0001/kembalikan"
      }
    },
    {
      "name": "Perpanjang Peminjaman",
      "request": {
        "method": "POST",
        "header": [{ "key": "X-API-Key", "value": "{{anggota_key}}" }],
        "url": "{{base_url}}/v1/perpus/peminjaman/PJM-20260916-0001/perpanjang"
      }
    },
    {
      "name": "Laporan Denda Harian",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "{{petugas_key}}" }],
        "url": "{{base_url}}/v1/perpus/laporan/denda-harian"
      }
    },
    {
      "name": "Laporan Buku Terpopuler",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-API-Key", "value": "{{petugas_key}}" }],
        "url": "{{base_url}}/v1/perpus/laporan/terpopuler"
      }
    }
  ]
}